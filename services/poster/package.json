{
  "name": "@suite/poster-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Social Poster backend: Fastify API and dispatch worker, two entrypoints from one package (D-022).",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:live": "node --env-file-if-exists=../../.env.local node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "gen:types": "node scripts/gen-types.mjs",
    "seed": "node --env-file-if-exists=../../.env.local dist/seed.js",
    "seed:constraints": "node dist/seed-constraints.js",
    "seed:grants": "node dist/seed-grants.js",
    "seed:demo": "node --env-file-if-exists=../../.env.local dist/seed-demo.js",
    "dev:api": "pnpm --filter='@suite/poster-service^...' build && exec tsx watch src/api/index.ts",
    "dev:worker": "pnpm --filter='@suite/poster-service^...' build && exec tsx watch src/worker/index.ts",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.2",
    "@suite/poster-contract": "workspace:*",
    "@suite/server-core": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "fastify": "^5.6.1",
    "pino": "^9.13.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@suite/poster-client": "workspace:*",
    "@suite/webhook-sink": "workspace:*",
    "@types/node": "^24.19.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
