{
  "openapi": "3.0.3",
  "info": {
    "title": "Social Poster internal API",
    "version": "1.3",
    "description": "Cross-platform publishing API. Two auth modes share every /v1 route (D-023): app mode uses a client-credentials JWT, user mode uses the signed-in user’s Supabase session JWT and acts as the first-party poster-web app."
  },
  "servers": [
    {
      "url": "/",
      "description": "The service root; deployments front this with TLS."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "App mode: the token from POST /v1/oauth/token. User mode: a Supabase session JWT."
      }
    },
    "schemas": {
      "TokenRequest": {
        "type": "object",
        "properties": {
          "grant_type": {
            "type": "string",
            "enum": ["client_credentials"]
          },
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "client_secret": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["grant_type", "client_id", "client_secret"],
        "additionalProperties": false,
        "description": "OAuth2 client-credentials request, form-encoded."
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT whose sub is the app id."
          },
          "token_type": {
            "type": "string",
            "enum": ["Bearer"]
          },
          "expires_in": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 9007199254740991,
            "description": "Seconds until the token expires."
          }
        },
        "required": ["access_token", "token_type", "expires_in"],
        "additionalProperties": false,
        "description": "A short-lived app access token."
      },
      "AuthContext": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["app", "user"],
            "description": "Which auth mode the caller used."
          },
          "app": {
            "type": "object",
            "properties": {
              "client_id": {
                "type": "string",
                "description": "The app the request acts as."
              },
              "first_party": {
                "type": "boolean"
              }
            },
            "required": ["client_id", "first_party"],
            "additionalProperties": false
          },
          "user_id": {
            "nullable": true,
            "description": "The user this request acts on behalf of, or null in app mode with no user.",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["mode", "app", "user_id"],
        "additionalProperties": false,
        "description": "Who the API thinks you are. Identical shape in both auth modes."
      },
      "PlatformConstraintsResponse": {
        "type": "object",
        "properties": {
          "platforms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "platform_id": {
                  "type": "string"
                },
                "display_name": {
                  "type": "string"
                },
                "supports_threads": {
                  "type": "boolean"
                },
                "spec_version": {
                  "type": "integer",
                  "minimum": 0,
                  "exclusiveMinimum": true,
                  "maximum": 9007199254740991
                },
                "updated_at": {
                  "type": "string"
                },
                "spec": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "object",
                      "properties": {
                        "max_length": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        },
                        "unit": {
                          "type": "string",
                          "enum": ["utf16_code_units", "utf8_bytes", "characters"],
                          "description": "How the platform counts length. utf16_code_units is what TikTok calls \"runes\"; utf8_bytes is a byte budget (YouTube descriptions); characters counts code points."
                        },
                        "forbidden_characters": {
                          "description": "Characters the platform rejects outright, e.g. < and > on YouTube.",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": ["max_length", "unit"],
                      "additionalProperties": false,
                      "description": "The main caption or body."
                    },
                    "title": {
                      "description": "Separate title field, where the platform has one.",
                      "type": "object",
                      "properties": {
                        "max_length": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        },
                        "unit": {
                          "type": "string",
                          "enum": ["utf16_code_units", "utf8_bytes", "characters"],
                          "description": "How the platform counts length. utf16_code_units is what TikTok calls \"runes\"; utf8_bytes is a byte budget (YouTube descriptions); characters counts code points."
                        },
                        "forbidden_characters": {
                          "description": "Characters the platform rejects outright, e.g. < and > on YouTube.",
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": ["max_length", "unit"],
                      "additionalProperties": false
                    },
                    "media": {
                      "type": "object",
                      "properties": {
                        "kinds": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "enum": ["image", "video"]
                          },
                          "description": "Media kinds this platform accepts at all."
                        },
                        "mime_types": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "description": "Accepted MIME types."
                        },
                        "min_count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "max_count": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["kinds", "mime_types", "min_count", "max_count"],
                      "additionalProperties": false,
                      "description": "What may be attached, and how much of it."
                    },
                    "video": {
                      "type": "object",
                      "properties": {
                        "max_duration_s": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMinimum": true
                        },
                        "max_duration_is_per_account": {
                          "type": "boolean",
                          "description": "True when the platform’s real ceiling is per-account and only knowable at dispatch time (TikTok returns max_video_post_duration_sec per creator). The value here is then the optimistic platform maximum, and a target passing validation may still be rejected by the platform."
                        }
                      },
                      "required": ["max_duration_s", "max_duration_is_per_account"],
                      "additionalProperties": false,
                      "description": "Duration limits for video."
                    },
                    "aspect_ratio": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "description": "Minimum width/height, as a decimal."
                        },
                        "max": {
                          "type": "number",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "description": "Maximum width/height, as a decimal."
                        },
                        "tolerance": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Slack on both ends, so 1079x1920 is not rejected for being one pixel off."
                        }
                      },
                      "required": ["min", "max", "tolerance"],
                      "additionalProperties": false,
                      "description": "Accepted width/height range."
                    },
                    "threads": {
                      "type": "object",
                      "properties": {
                        "supported": {
                          "type": "boolean"
                        },
                        "max_parts": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["supported"],
                      "additionalProperties": false,
                      "description": "Whether ordered multi-part posts are possible (FR-08)."
                    },
                    "sources": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "url": {
                            "type": "string",
                            "format": "uri"
                          },
                          "retrieved": {
                            "type": "string",
                            "description": "ISO date the value was read from that page."
                          },
                          "note": {
                            "type": "string"
                          }
                        },
                        "required": ["url", "retrieved"],
                        "additionalProperties": false,
                        "description": "Where a number came from. Provenance travels with the data."
                      },
                      "description": "Citations for every limit above."
                    },
                    "provisional": {
                      "type": "boolean",
                      "description": "True while the numbers come from platform documentation rather than the aggregator we actually post through. The aggregator is often stricter, so S09 replaces these (OQ-1)."
                    }
                  },
                  "required": ["text", "media", "threads", "sources", "provisional"],
                  "additionalProperties": false,
                  "description": "Everything needed to validate one target for one platform."
                }
              },
              "required": [
                "platform_id",
                "display_name",
                "supports_threads",
                "spec_version",
                "updated_at",
                "spec"
              ],
              "additionalProperties": false,
              "description": "One platform’s published constraints."
            }
          }
        },
        "required": ["platforms"],
        "additionalProperties": false,
        "description": "Published platform limits, so no client ever hard-codes them."
      },
      "ValidatePostRequest": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The user whose connections and media these are."
          },
          "content": {
            "type": "object",
            "properties": {
              "text": {
                "description": "Default caption for every target.",
                "type": "string"
              },
              "title": {
                "description": "Default title, for platforms that have one.",
                "type": "string"
              },
              "media": {
                "description": "Public media ids, in order.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "thread": {
                "description": "Ordered multi-part post (FR-08). Rejected on platforms without threads.",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "media": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": ["text"],
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "description": "What to post, before per-target overrides."
          },
          "targets": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "connection_id": {
                  "type": "string",
                  "description": "Public connection id, e.g. cn_…"
                },
                "overrides": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "description": "Per-platform replacements for the default content."
                }
              },
              "required": ["connection_id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["user_id", "content", "targets"],
        "additionalProperties": false,
        "description": "A post submission to check without creating anything."
      },
      "ValidatePostResponse": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "enum": [true]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "connection_id": {
                  "type": "string"
                },
                "platform_id": {
                  "type": "string"
                }
              },
              "required": ["target_index", "connection_id", "platform_id"],
              "additionalProperties": false
            }
          }
        },
        "required": ["valid", "targets"],
        "additionalProperties": false,
        "description": "Returned only when every target passes. Failures use the §8 422 envelope."
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "invalid_token",
                  "forbidden_user",
                  "grant_missing",
                  "not_found",
                  "idempotency_conflict",
                  "too_late",
                  "constraint_violation",
                  "rate_limited",
                  "internal_error"
                ],
                "description": "Machine-readable error code."
              },
              "message": {
                "type": "string",
                "description": "Human-readable summary. Never used for control flow."
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "target_index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991,
                      "description": "Index of the failing target in the submitted targets array."
                    },
                    "connection_id": {
                      "description": "Public id of the target connection.",
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "description": "Constraint code; see the contract §8 list."
                    },
                    "constraint": {
                      "description": "The limit that was exceeded and the actual value, as data.",
                      "type": "object",
                      "additionalProperties": {}
                    }
                  },
                  "required": ["target_index", "code"],
                  "additionalProperties": false,
                  "description": "One per failing target, so a client can fix exactly what broke."
                }
              },
              "request_id": {
                "type": "string",
                "description": "Echoes the X-Request-Id response header. Quote it in support requests."
              }
            },
            "required": ["code", "message", "request_id"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false,
        "description": "The single error envelope used by every non-2xx response."
      }
    }
  },
  "paths": {
    "/v1/oauth/token": {
      "post": {
        "operationId": "createToken",
        "summary": "Exchange client credentials for a short-lived app token",
        "description": "Form-encoded, per OAuth2. The returned JWT is valid for 15 minutes and its sub claim identifies the app. App credentials alone never authorize publishing: acting for a user also requires that user’s grant.",
        "tags": ["auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A new access token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or unsupported grant_type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unknown client_id, wrong client_secret, or disabled app.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many token requests; honor Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/auth/context": {
      "get": {
        "operationId": "getAuthContext",
        "summary": "Report who the API thinks you are",
        "description": "Returns the acting app and user for the presented token. The response shape is identical in both auth modes, which makes it the cheapest way for a client to confirm its credentials and the user it is acting for.",
        "tags": ["auth"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The user to act as. Required in app mode for user-scoped work; in user mode it must equal the token subject or the request is rejected with forbidden_user."
          }
        ],
        "responses": {
          "200": {
            "description": "The resolved auth context.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthContext"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "User-mode token does not match the requested user_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Per-app rate limit exceeded; honor Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/platforms/constraints": {
      "get": {
        "operationId": "getPlatformConstraints",
        "summary": "Published platform limits, as data",
        "description": "Every limit the constraint engine enforces, so no client hard-codes a platform rule (CLAUDE.md rule 9). Each spec carries its own `sources` and a `provisional` flag: while provisional, the numbers come from platform documentation rather than the aggregator actually used to post, which is often stricter. Limits marked `max_duration_is_per_account` are an optimistic ceiling that only the platform can confirm for a given account.",
        "tags": ["platforms"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Constraints for every enabled platform.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlatformConstraintsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Per-app rate limit exceeded; honor Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/v1/posts/validate": {
      "post": {
        "operationId": "validatePost",
        "summary": "Check a post against platform rules without creating it",
        "description": "Runs exactly the validation POST /v1/posts runs, and returns exactly the same 422 envelope, so a composer can show per-platform warnings before submitting rather than reimplementing the rules. Nothing is created and nothing is reserved. A clean post returns 200; any violation returns 422 with one `details` entry per failing target.",
        "tags": ["posts"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidatePostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every target passes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidatePostResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or expired token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "403": {
            "description": "User-mode token does not match the requested user_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "A connection or media id does not exist for this user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "One or more targets failed platform rules; see details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Per-app rate limit exceeded; honor Retry-After.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  }
}
